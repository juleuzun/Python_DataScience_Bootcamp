    {
      "cell_type": "markdown",
      "source": [
        "# Visualizing Model Performance"
      ],
      "metadata": {
        "id": "fDzVZmqmwe-t"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# MSE Comparison\n",
        "# A bar plot will be generated to compare the Mean Squared Error (MSE) values across all four models. This visualization helps easily identify which model achieved the lowest prediction error on the test dataset.\n",
        "\n",
        "plt.figure(figsize=(10, 5))\n",
        "\n",
        "plt.bar(results['Model'] , results['MSE'])\n",
        "\n",
        "plt.title('Comparison of Regression Models Based on MSE')\n",
        "plt.xlabel('Model')\n",
        "plt.ylabel('MSE')\n",
        "\n",
        "plt.show()"
      ],
      "metadata": {
        "colab": {
